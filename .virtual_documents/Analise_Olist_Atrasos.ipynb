plt.title("Matriz de Confusão")
plt.xlabel("Classe prevista")
plt.ylabel("Classe real")

plt.tight_layout()

plt.savefig(
    PASTA_FIGURAS / "08_matriz_confusao.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()


fpr, tpr, _ = roc_curve(
    y_test,
    prob_teste
)

plt.figure(figsize=(7, 5))

plt.plot(
    fpr,
    tpr,
    label=f"ROC-AUC = {roc_auc_final:.3f}"
